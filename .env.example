# AEON Environment Configuration Example

# Application
APP_NAME="AEON - Agent Procurement Control Plane"
APP_ENV="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Security & Secrets
SECRET_KEY="generate-a-secure-random-secret-key-at-least-32-chars-long"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_SCHEME="argon2"

# Agent API Keys
AGENT_KEY_PREFIX="aeon_live_"

# CORS Origins (Specify frontend URLs - never wildcard with credentials)
CORS_ORIGINS="https://aeon-control.vercel.app,http://localhost:3000,http://localhost:5173"

# Database (Supabase PostgreSQL / asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# PayPal Sandbox Configuration
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"
PAYPAL_MODE="sandbox"
PAYPAL_RETURN_URL="https://aeon-control.vercel.app/payments/success"
PAYPAL_CANCEL_URL="https://aeon-control.vercel.app/payments/cancel"

# ML Recommendation Model Integration
ML_PROVIDER_TYPE="mock" # Set to "module" when teammate model is available
ML_MODULE_PATH="app.integrations.ml.mock_provider"
ML_TIMEOUT_SECONDS=5.0

# Procurement Defaults
DEFAULT_CURRENCY="USD"
